# Server port (automatically set by Render, Railway, Fly.io, etc.)
PORT=4000

# Option 1 (Default — Local / VPS / Docker with persistent volume):
# Uses Node's built-in SQLite database file (no external database needed)
SQLITE_PATH=./data/verdant.sqlite

# Option 2 (Recommended for Cloud Deployment — Render, Railway, Supabase, Neon):
# When DATABASE_URL is set, Verdant automatically uses PostgreSQL and creates all tables on startup!
# DATABASE_URL=postgres://user:password@host:5432/verdant
